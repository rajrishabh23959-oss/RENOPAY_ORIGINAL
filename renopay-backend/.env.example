# RenoPay Environment Variables
# Copy this file to .env and fill in real values. Never commit .env itself to Git.

# --- App Settings ---
APP_NAME=RenoPay
ENV=development # development | staging | production
DEBUG=true      # Set to false in production

# --- Database ---
# Option 1: SQLite (Default for zero-setup local dev)
DATABASE_URL=sqlite+aiosqlite:///./renopay.db
SYNC_DATABASE_URL=sqlite:///./renopay.db

# Option 2: PostgreSQL (Recommended for Docker & Production)
# DATABASE_URL=postgresql+asyncpg://renopay:renopay@localhost:5432/renopay
# SYNC_DATABASE_URL=postgresql+psycopg2://renopay:renopay@localhost:5432/renopay

# --- Redis (OTP cache, rate limiting, token tracking) ---
REDIS_URL=redis://localhost:6379/0

# --- Security & Cryptography ---
# Required for non-development environments!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Token lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- SMS / OTP Provider ---
# "console" logs OTP to backend logs (and includes debug_otp in responses during dev)
# "twilio" sends real SMS via Twilio (requires: pip install twilio)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- CORS Allowed Origins ---
# Accepts JSON array or comma-separated list of origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://10.0.2.2:8000","http://10.0.2.2:5173"]
